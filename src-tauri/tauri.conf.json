{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IPTV Player",
  "version": "0.1.0",
  "identifier": "com.argygkou.iptvplayer",
  "build": {
    "frontendDist": "../dist/iptv-player/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IPTV Player",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "img-src": "'self' data: blob: http: https:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "IPTV player for Xtream Codes providers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
